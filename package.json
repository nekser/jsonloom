{
  "name": "jsonloom-app",
  "version": "0.1.4",
  "description": "Browser-based JSON transformation workspace with composable operation pipelines.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekser/json-tool-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nekser/json-tool-ui/issues"
