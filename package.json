    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export:ops": "tsx scripts/export-operations-json.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.unit.config.ts tests/unit --runInBand",
    "test:integration": "jest --config jest.config.ts tests/e2e --runInBand",
    "test:coverage": "jest --config jest.unit.config.ts tests/unit --coverage --runInBand",
    "test:e2e": "jest --config jest.config.ts --runInBand",
    "check:dev": "node scripts/smoke-dev-routes.mjs",
    "check": "pnpm lint && pnpm test:unit && pnpm test:integration",
    "seo:submit-sitemap": "node scripts/submit-sitemap.mjs",
    "seo:indexnow": "node scripts/indexnow-ping.mjs",
    "seo:notify": "pnpm seo:submit-sitemap && pnpm seo:indexnow"
