# Public app metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=maintainers@example.com
CONTACT_EMAIL=maintainers@example.com
NEXT_PUBLIC_APP_VERSION=0.1.0

# Feature flags
# true/1 enables docs + codegen panels
NEXT_PUBLIC_ENABLE_DOCS_AND_CODEGEN=false
# main (default) or worker
NEXT_PUBLIC_PIPELINE_EXECUTION_MODE=main

# Robots / crawler controls
# true/1 blocks known AI training bots in robots policy
BLOCK_AI_TRAINING_BOTS=false

# Dev smoke route checker (optional)
SMOKE_PORT=3100
SMOKE_HOST=127.0.0.1
SMOKE_START_TIMEOUT_MS=45000
SMOKE_ROUTE_TIMEOUT_MS=12000
ROUTES=/,/docs,/about,/privacy,/cookies

# SEO scripts (optional)
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SITEMAP_URL=
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_LOCATION=
INDEXNOW_URLS=/,/docs,/about
