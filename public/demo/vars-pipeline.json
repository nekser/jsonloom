{
  "schemaVersion": 1,
  "ops": [
    {
      "id": "compute-avg-price",
      "type": "ReduceArray",
      "config": { "path": "orders", "op": "avg", "by": "price", "writeResultTo": "_metrics.avgPrice" }
    },
    {
      "id": "map-orders",
      "type": "MapArray",
      "config": {
        "path": "orders",
        "operations": [
          {
            "id": "set-deviation",
            "type": "SetPath",
            "config": {
              "path": "deviation",
              "value": "${current.price - _metrics.avgPrice}"
            }
          }
        ]
      }
    }
  ]
}
