{
  "v": 1,
  "ops": [
    {
      "id": "op-extract-users",
      "type": "ExtractPath",
      "config": { "path": "users" }
    },
    {
      "id": "op-map-users",
      "type": "MapArray",
      "config": {
        "path": ".",
        "operations": [
          {
            "id": "op-user-name-upper",
            "type": "StringCase",
            "config": { "path": "name", "mode": "uppercase", "coerceNonString": false }
          },
          {
            "id": "op-user-label",
            "type": "TemplateInterpolate",
            "config": { "path": "label", "template": "${name} <${email}>", "onMissing": "literal" }
          },
          {
            "id": "op-orders-count",
            "type": "CountArray",
            "config": { "path": "orders" }
          }
        ],
        "onError": "propagate"
      }
    },
    {
      "id": "op-filter-has-orders",
      "type": "FilterArray",
      "config": { "path": ".", "key": "orders", "operator": "gt", "value": 0, "mode": "keep" }
    },
    {
      "id": "op-rename-orders",
      "type": "RenameKey",
      "config": { "from": "orders", "to": "orderCount" }
    },
    {
      "id": "op-sort-by-name",
      "type": "SortArray",
      "config": { "path": ".", "by": "name", "order": "asc", "caseInsensitive": true, "nulls": "last" }
    }
  ]
}
